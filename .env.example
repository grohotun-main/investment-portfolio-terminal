# Copy this file to .env (which is gitignored) and fill in your own values.
# Every key is OPTIONAL for the demo path — the app runs fully offline on the
# generated synthetic dataset.

# Polygon.io API key for live price + benchmark refreshes. ("MASSIVE" is this
# codebase's historical alias for the Polygon data API.) Get one at
# https://polygon.io — the free tier covers ~2y of daily history.
# MASSIVE_API_KEY=PASTE_YOUR_KEY_HERE

# Optional override — defaults to api.polygon.io
# MASSIVE_API_BASE=https://api.polygon.io

# Optional: FRED API key for the risk-free rate (DGS3MO 3-month T-bill yield).
# Free, instant: https://fredaccount.stlouisfed.org/apikeys
# FRED_API_KEY=PASTE_YOUR_FRED_KEY_HERE

# Optional: Anthropic API key for live AI narration and the AI Analysis tab.
# Without it the demo serves the committed pre-generated analysis cache; the
# rest of the app is unaffected.
# ANTHROPIC_API_KEY=PASTE_YOUR_KEY_HERE

# Optional: point the app at an alternate data directory (defaults to ./data).
# APP_DATA_DIR=
